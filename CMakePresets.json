{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "PE_LIBRARY_TYPE": "STATIC",
                "BUILD_TESTING": "ON",
                "PE_BUILD_INTERFACE_TESTS": "ON",
                "PE_BUILD_EXAMPLES": "OFF",
                "PE_BUILD_LIVE_VIEWER": "OFF",
                "PE_USE_MPI": "OFF",
                "PE_MPI_PREINCLUDE": "OFF",
                "PE_USE_CGAL": "OFF",
                "PE_USE_EIGEN": "ON",
                "PE_USE_JSON": "ON",
                "PE_USE_BLAS": "OFF",
                "PE_USE_OPENCL": "OFF",
                "PE_USE_IRRLICHT": "OFF",
                "PE_USE_ACCELERATED_POINT_QUERY": "OFF",
                "PE_VERIFY_HASHGRID": "OFF"
            }
        },
        {
            "name": "serial",
            "displayName": "Serial Release",
            "description": "Static Release build with the complete serial CTest suite",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/presets/serial"
        },
        {
            "name": "debug",
            "displayName": "Serial Debug",
            "description": "Static Debug build with the complete serial CTest suite",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/presets/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "mpi",
            "displayName": "MPI Release",
            "description": "Static Release build with MPI enabled independently of CGAL",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/presets/mpi",
            "cacheVariables": {
                "PE_USE_MPI": "ON"
            }
        },
        {
            "name": "cgal",
            "displayName": "CGAL Release",
            "description": "Static Release build with CGAL and DistanceMap coverage, without MPI",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/presets/cgal",
            "cacheVariables": {
                "PE_USE_CGAL": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-serial",
            "displayName": "Build Serial Release",
            "configurePreset": "serial",
            "jobs": 2
        },
        {
            "name": "build-debug",
            "displayName": "Build Serial Debug",
            "configurePreset": "debug",
            "jobs": 2
        },
        {
            "name": "build-mpi",
            "displayName": "Build MPI Release",
            "configurePreset": "mpi",
            "jobs": 2
        },
        {
            "name": "build-cgal",
            "displayName": "Build CGAL Release",
            "configurePreset": "cgal",
            "jobs": 2
        }
    ],
    "testPresets": [
        {
            "name": "test-serial",
            "displayName": "Test Serial Release",
            "configurePreset": "serial",
            "filter": {
                "include": {
                    "label": "serial"
                }
            },
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "error",
                "timeout": 180
            }
        },
        {
            "name": "test-debug",
            "displayName": "Test Serial Debug",
            "configurePreset": "debug",
            "filter": {
                "include": {
                    "label": "serial"
                }
            },
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "error",
                "timeout": 180
            }
        },
        {
            "name": "test-mpi",
            "displayName": "Test MPI Release",
            "configurePreset": "mpi",
            "filter": {
                "include": {
                    "label": "mpi"
                }
            },
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "error",
                "timeout": 180
            }
        },
        {
            "name": "test-cgal",
            "displayName": "Test CGAL Release",
            "configurePreset": "cgal",
            "filter": {
                "include": {
                    "label": "cgal"
                }
            },
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "error",
                "timeout": 180
            }
        }
    ]
}
